# QQ 个人邮箱示例；用户名填完整邮箱，密码填客户端授权码。
MAIL_USERNAME=your_account@qq.com
MAIL_PASSWORD=replace_with_mail_authorization_code
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# ssl 对应 465；其他提供商如需 587，改成 starttls。
SMTP_SECURITY=ssl

# 收件人名单：AI 不接触或修改地址，只能由程序使用这些联系人。
CONTACTS_JSON='{"owner":"your_notification_address@example.com"}'
NOTIFY_CONTACT=owner
DIGEST_CONTACT=owner

# 示例使用 DeepSeek；也可换成支持 Chat Completions 的模型服务。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace_with_model_api_key
LLM_MODEL=deepseek-flash
LLM_JSON_MODE=true
LLM_EXTRA_JSON='{"thinking":{"type":"disabled"}}'

# true：生成 .eml 预览，不连接 SMTP 发信。仍会读取邮箱、调用模型 API。
DRY_RUN=true
TIMEZONE=Asia/Shanghai
POLL_SECONDS=60
# 仅搜索从 N 天前的本地零点至今的未读邮件；0 表示所有未读。
LOOKBACK_DAYS=1
MAX_PER_POLL=20
MAX_BODY_CHARS=8000
NOTIFY_IMPORTANT=true
IMPORTANCE_RULE=需要我采取行动、有截止日期、合同或付款相关的邮件视为重要；广告和订阅资讯不重要。
DIGEST_ENABLED=true
DIGEST_TIME=18:00
DIGEST_INSTRUCTION=用中文汇总本日已处理邮件，按重要事项、待办、普通信息分组；不得编造进展或承诺。
