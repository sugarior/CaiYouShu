[Unit]
Description=CaiYouShu multi-account demo platform
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/CaiYouShu
ExecStart=/home/ubuntu/CaiYouShu/.venv/bin/python -u /home/ubuntu/CaiYouShu/multiuser.py --port 8788 --data /home/ubuntu/CaiYouShu/demo-data
Environment=CAIYOUSHU_PUBLIC_ORIGIN=https://81.69.224.197
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/ubuntu/CaiYouShu/demo-data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=caiyoushu-platform

[Install]
WantedBy=multi-user.target
